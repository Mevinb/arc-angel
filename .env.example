# JARVIS environment variables — copy to .env and fill in.
# NOTE: .env is gitignored. Never commit real keys.

# --- LLM routing (OmniRoute or any OpenAI-compatible gateway) ---
# OmniRoute default endpoint (https://github.com/diegosouzapw/OmniRoute)
JARVIS_LLM_BASE_URL=http://localhost:20128/v1
JARVIS_LLM_API_KEY=
# Model roles — 'auto' routing works on OmniRoute zero-config
JARVIS_MODEL_FAST=auto/fast
JARVIS_MODEL_REASONING=auto
JARVIS_MODEL_VISION=auto

# --- Gmail API (Phase 5) ---
# Place OAuth client secret at data/gmail-credentials.json (Google Cloud Console)
# Token is cached at data/gmail-token.json after first interactive login.
JARVIS_GMAIL_CREDENTIALS=data/gmail-credentials.json
JARVIS_GMAIL_TOKEN=data/gmail-token.json

# --- Behaviour ---
# auto | interactive | yolo  (see jarvis/safety/permissions.py)
JARVIS_SAFETY_MODE=interactive

# --- Skills (SKILL.md library) ---
# Root directory of the skill collection. Defaults to <project>/data/skills
# (run `jarvis skills install` to populate it). Point this at any directory
# containing skills-index.json and a 'content' subdir (or the ai-agent-skills dir).
# JARVIS_SKILLS_ROOT=/absolute/path/to/skills/root
