# ARC environment variables — copy to .env and fill in.
# NOTE: .env is gitignored. Never commit real keys.

# --- LLM routing (OmniRoute or any OpenAI-compatible gateway) ---
# OmniRoute default endpoint (https://github.com/diegosouzapw/OmniRoute)
ARC_LLM_BASE_URL=http://localhost:20128/v1
ARC_LLM_API_KEY=
# Model roles — 'auto' routing works on OmniRoute zero-config
ARC_MODEL_FAST=auto/fast
ARC_MODEL_REASONING=auto
ARC_MODEL_VISION=auto

# --- Gmail API (Phase 5) ---
# Place OAuth client secret at data/gmail-credentials.json (Google Cloud Console)
# Token is cached at data/gmail-token.json after first interactive login.
ARC_GMAIL_CREDENTIALS=data/gmail-credentials.json
ARC_GMAIL_TOKEN=data/gmail-token.json

# --- Behaviour ---
# auto | interactive | yolo  (see arc/safety/permissions.py)
ARC_SAFETY_MODE=interactive

# --- Skills (SKILL.md library) ---
# Root directory of the skill collection. Defaults to <project>/data/skills
# (run `arc skills install` to populate it). Point this at any directory
# containing skills-index.json and a 'content' subdir (or the ai-agent-skills dir).
# ARC_SKILLS_ROOT=/absolute/path/to/skills/root

# --- Voice (always-listening, full duplex, local RTX 4050 6GB) ---
# Local STT/TTS — no cloud, no cost. Needs: pip install -e ".[voice]" (+ [kokoro] for Kokoro)
# System deps: sudo apt install portaudio19-dev espeak espeak-data
# ARC_VOICE_STT=faster-whisper
# ARC_VOICE_STT_MODEL=small      # tiny/small/medium/large-v3 — small=500MB, medium=1.5GB on 6GB
# ARC_VOICE_TTS=auto             # auto → kokoro (~2GB VRAM) → piper → pyttsx3
# ARC_VOICE_DEVICE=auto          # auto → cuda if available else cpu
